# Caddy + Soketi Docker Compose Environment Variables
# Copy this file to .env and update with your values

# ============================================
# Soketi Configuration
# ============================================

# Server Configuration
SOKETI_IMAGE=funal/soketi-rs:latest
PUSHER_HOST=0.0.0.0
PUSHER_PORT=6001
PUSHER_METRICS_PORT=9601
PUSHER_DEBUG=false

# App Configuration
# IMPORTANT: Change these values in production!
PUSHER_DEFAULT_APP_ID=app-id
PUSHER_DEFAULT_APP_KEY=app-key
PUSHER_DEFAULT_APP_SECRET=change-me

# ============================================
# Caddy Configuration
# ============================================

# Domain for automatic HTTPS
DOMAIN=soketi.example.com

# ============================================
# Network Configuration
# ============================================

# Subnet for Docker network
SOKETI_NETWORK_SUBNET=172.20.0.0/16

# ============================================
# Port Mappings
# ============================================

# Caddy Ports
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443

# ============================================
# Volume Paths (optional)
# ============================================

# Custom config file path
# PUSHER_CONFIG_PATH=./config.json

# Custom Caddyfile path
# CADDYFILE_PATH=./Caddyfile

# Custom SSL certificates path
# SSL_CERTS_PATH=./certs
