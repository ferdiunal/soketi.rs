{
	# Global options
	admin off
	# auto_https is enabled by default for domains with valid certificates
	# To disable: auto_https off
	# To disable redirects: auto_https disable_redirects
	# To disable automatic certificate management: auto_https disable_certs
	servers {
		protocols h1 h2 h3
	}
}

# HTTP listener for container health checks and HTTPS redirects.
:80 {
	handle /health {
		respond "healthy" 200
	}

	handle {
		redir https://{host}{uri} permanent
	}
}

# Production configuration with HTTPS
# Set DOMAIN in .env to your actual domain.
{$DOMAIN:soketi.example.com} {
	# WebSocket proxy to soketi server
	reverse_proxy /app/* {
		to soketi:6001
		header_up Host {host}
		header_up X-Real-IP {remote}

		# WebSocket specific headers
		header_up Connection {>Connection}
		header_up Upgrade {>Upgrade}
	}

	reverse_proxy /apps/* {
		to soketi:6001
		header_up Host {host}
		header_up X-Real-IP {remote}
	}

	# Security headers
	header {
		# HTTP Strict Transport Security (HSTS)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"

		# Prevent clickjacking
		X-Frame-Options "DENY"

		# XSS Protection
		X-XSS-Protection "1; mode=block"
	}

	# Health check endpoint
	respond /health "healthy" 200
}
